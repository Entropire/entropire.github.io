---
---

<section class="hero" aria-hidden="true">
    <div class="hero-bg"></div>
    <div class="particles"></div>

    <div class="arc-glow">
        <svg viewBox="0 0 1000 1000" preserveAspectRatio="none">
            <defs>
                <linearGradient id="glow-gradient" x1="0%" y1="100%" x2="0%" y2="0%">
                    <stop offset="0%" stop-color="rgba(0, 255, 128, 0.08)" />
                    <stop offset="40%" stop-color="rgba(0, 255, 128, 0.04)" />
                    <stop offset="70%" stop-color="rgba(0, 255, 128, 0.01)" />
                    <stop offset="100%" stop-color="rgba(0, 255, 128, 0)" />
                </linearGradient>
            </defs>
            <path
                d="M 0 1000 L 100 1000 Q 500 600 900 1000 L 1000 1000 L 1000 0 Q 500 50 0 0 Z"
                fill="url(#glow-gradient)"
            />
        </svg>
    </div>

    <div class="arc">
        <svg viewBox="0 0 1000 1000" preserveAspectRatio="none">
            <defs>
                <linearGradient id="edge-fade" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="black" stop-opacity="0" />
                    <stop offset="12%" stop-color="white" stop-opacity="1" />
                    <stop offset="88%" stop-color="white" stop-opacity="1" />
                    <stop offset="100%" stop-color="black" stop-opacity="0" />
                </linearGradient>
                <mask id="edge-fade-mask">
                    <rect x="0" y="0" width="1000" height="1000" fill="url(#edge-fade)" />
                </mask>
            </defs>
            <path
                    d="M 0 1000 L 100 998 Q 500 600 900 998 L 1000 1000"
                    fill="none"
                    stroke="rgba(0, 255, 128, 0.25)"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    vector-effect="non-scaling-stroke"
                    mask="url(#edge-fade-mask)"
            />
        </svg>
    </div>
</section>

<style>
    .hero {
        position: relative;
        height: 100dvh;
        overflow: hidden;
    }

    .hero-bg {
        position: absolute;
        inset: 0;
        background: var(--color-bg);
        clip-path: polygon(
            0% 0%, 100% 0%,
            100% 100%,
            90% 99.8%, 82% 92.6%, 74% 87.1%, 66% 83.1%,
            58% 80.7%, 50% 79.9%, 42% 80.7%, 34% 83.1%,
            26% 87.1%, 18% 92.6%, 10% 99.8%,
            0% 100%
        );
        z-index: 0;
    }

    .hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 6rem;
        background: linear-gradient(to bottom, var(--color-bg), transparent);
        z-index: 1;
        pointer-events: none;
    }

    .arc,
    .arc-glow {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100dvh;
        pointer-events: none;
        z-index: 1;
    }

    .arc {
        left: 50%;
        transform: translateX(-50%) translateZ(0);
    }

    .arc svg,
    .arc-glow svg {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .particles {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100dvh;
        pointer-events: none;
        overflow: hidden;
        z-index: 1;
    }

    :global(.particle) {
        position: absolute;
        width: 2px;
        height: 2px;
        border-radius: 50%;
        animation: float-up 8s linear infinite;
        transform: translateZ(0);
        --drift-x: 0px;
    }

    @keyframes float-up {
        0% {
            transform: translateY(0) translateX(0) translateZ(0);
            opacity: 0.8;
        }
        100% {
            transform: translateY(-60vh) translateX(var(--drift-x)) translateZ(0);
            opacity: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(.particle) {
            animation: none;
        }
    }
</style>

<script>
    function createParticles() {
        const container = document.querySelector('.hero .particles');
        if (!container) return;

        container.innerHTML = '';

        for (let i = 0; i < 30; i++) {
            const particle = document.createElement('div');
            particle.className = 'particle';

            const t = (i / 30) * 1.1 - 0.05;
            const x = (1 - t) * (1 - t) * 100 + 2 * (1 - t) * t * 500 + t * t * 900;
            const y = (1 - t) * (1 - t) * 1000 + 2 * (1 - t) * t * 600 + t * t * 1000;

            const arcHeight = (1000 - y) / 10;
            const hue = 155 + Math.random() * 20;
            const saturation = 90 + Math.random() * 10;
            const lightness = 45 + Math.random() * 10;

            particle.style.left = `${(x / 1000) * 100}%`;
            particle.style.bottom = `${arcHeight + Math.random() * 10}vh`;
            particle.style.animationDelay = `${-Math.random() * 8}s`;
            particle.style.setProperty('--drift-x', `${(Math.random() - 0.5) * 40}px`);
            particle.style.background = `hsla(${hue}, ${saturation}%, ${lightness}%, 0.7)`;
            particle.style.boxShadow = `0 0 6px 2px hsla(${hue}, ${saturation}%, ${lightness}%, 0.3)`;

            container.appendChild(particle);
        }
    }

    document.addEventListener('astro:page-load', () => {
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            createParticles();
        }
    });
</script>
