---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCart from '../components/projectCart.astro';
import Icon from "../components/Icon.astro"

import icon_email from "../assets/icons/email.svg?raw"
import icon_file from "../assets/icons/file.svg?raw"
import icon_github from "../assets/icons/github.svg?raw"
import icon_linkedin from "../assets/icons/linkedin.svg?raw"
---

<BaseLayout title="Home">
    <div class="hero">
        <div class="hero-text">
            <h1>Quinten Duijster</h1>
            <h3>An energetic backend developer</h3>
            <div class="hero-links">
                <Icon class="icon" img={icon_email} href="mailto:qduyster14@gmail.com"/>
                <Icon class="icon" img={icon_file} href="CV-QuintenDuijster.pdf" download/>
                <Icon class="icon" img={icon_github} href="https://github.com/Entropire" target="blank"/>
                <Icon class="icon" img={icon_linkedin} href="https://www.linkedin.com/in/quinten-duijster" target="blank"/>
            </div>
        </div>
        <img class="hero-img" src="./favicon.png" alt="favicon">
    </div>
</BaseLayout>

<style>
.hero {
    height: calc(100vh - 56px);

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5%;
}

.hero-img{
    border-radius: 45%;
}

.hero-text{
    text-align: right;
}

.hero-text,
.hero-img{
    width: 40%;
    
}

.hero-text h1{
    color: var(--color-primary);
}

.hero-text h3 {
    color: var(--color-text-muted);
}

.hero-links {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    margin-top: 1rem;
}


@media (max-width: 1400px) {
    .hero{
        flex-direction: column-reverse;
    }

    .hero-text,
    .hero-img{
        width: 80%;
    }

    .hero-text{
        text-align: center;
    }

    .hero-img{
        max-width: 300px;
    }

    .hero-links{
        justify-content: center;
    }
}
</style>