---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCart from '../components/projectCart.astro';
---

<BaseLayout title="Home">
    <div class="hero">
        <div class="hero-text">
            <h1>Quinten Duijster</h1>
            <h3>An energetic backend developer</h3>
        </div>
        <img class="hero-img" src="./favicon.png" alt="favicon">
    </div>


    <div class="project-preview">
        <h2>Project preview</h2>
        <div class="project-container">
            <ProjectCart/>
            <ProjectCart/>
            <ProjectCart/>
            <ProjectCart/>
        </div>
    </div>
</BaseLayout>

<style>
.hero {
    height: calc(100vh - 56px);

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5%;
}

.hero-img{
    border-radius: 45%;
}

.hero-text{
    text-align: right;
}

.hero-text,
.hero-img{
    width: 40%;
    
}

.hero-text h1{
    color: var(--color-primary);
}

.hero-text h3 {
    color: var(--color-text-muted);
}

@media (max-width: 750px) {
    .hero{
        flex-direction: column-reverse;
    }

    .hero-text,
    .hero-img{
        width: 80%;
    }

    .hero-text{
        text-align: center;
    }

    .hero-img{
        max-width: 300px;
    }
}

.project-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
}

.project-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    width: 100%;
}
</style>