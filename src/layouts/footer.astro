---
import '../styles/layouts/footer.css'
import Icon from '../components/Icon.astro'

import File_Icon from '../assets/icons/file.svg?raw'
import Email_Icon from '../assets/icons/email.svg?raw'
import Linkedin_Icon from '../assets/icons/linkedin.svg?raw'
import Github_Icon from '../assets/icons/email.svg?raw'
---

<footer class="footer">
    <div class="footer-content">
        <div class="footer-icons">
            <Icon href="./CV-QuintenDuijster.pdf" img={File_Icon} download/>
            <Icon href="mailto:qduyster14@gmail.com" img={Email_Icon} />
            <Icon href="https://www.linkedin.com/in/quinten-duijster" img={Linkedin_Icon} />
            <Icon href="https://github.com/Entropire" img={Github_Icon} />
        </div>
        <div class="footer-divider"></div>
        <p class="footer-text">&copy; {new Date().getFullYear()} Quinten Duijster - All rights reserved</p>
    </div>
</footer>
