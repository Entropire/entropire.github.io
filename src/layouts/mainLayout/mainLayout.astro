---
import Header from "../header.astro"
import Footer from "../footer.astro"
import BaseLayout from "../BaseLayout.astro"
const {
    title = '',
} = Astro.props
---


<BaseLayout title={title}>
    <Header/>
    <main>
        <aside class="left">
            <slot name="left" />
        </aside>

        <section class="center">
            <slot />
        </section>

        <aside class="right">
            <slot name="right" />
        </aside>
    </main>
    <Footer/>
</BaseLayout>

