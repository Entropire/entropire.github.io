---
import "../../styles/global.css";
import Header from "./header.astro"
import Footer from "../footer.astro"
import BaseLayout from "../BaseLayout.astro"
const {
    title = '',
} = Astro.props
---

<BaseLayout title={title}>
    <Header/>
    <slot name="hero" />
    <main>
        <aside class="left">
            <slot name="left" />
        </aside>

        <section class="center">
            <slot />
        </section>

        <aside class="right">
            <slot name="right" />
        </aside>
    </main>
    <Footer/>
</BaseLayout>